# Copy this file to .env and fill in real values before running the app.
# Never commit your real .env file to a public repository.

# Required for the AI chat demo and script generator to actually respond.
# Get this from https://console.anthropic.com (Anthropic's developer console).
ANTHROPIC_API_KEY=

# Check https://docs.claude.com/en/docs/about-claude/models for the current
# model name before deploying -- model names change over time, so confirm
# the exact string there rather than trusting this default blindly.
CLAUDE_MODEL=claude-haiku-4-5

# Port the local server runs on. Most hosting providers (Vercel, Render,
# Railway) set this automatically -- you usually don't need to touch it.
PORT=3000

# --- Where client data is stored ---
# Leave blank for local testing. On Render, once you've attached a Persistent
# Disk (see LAUNCH_CHECKLIST.md), set this to that disk's mount path (e.g.
# /var/data) -- without it, client data is silently wiped on every restart,
# redeploy, or free-tier spin-down.
DATA_DIR=

# --- Retell (required for the dashboard's "Create phone agent" button to
# create a real, callable phone agent -- without this, that button shows a
# demo-mode message instead) ---
# Get this from https://www.retellai.com after creating an account and
# adding a payment method. Each client's actual phone number is bought and
# assigned inside Retell's own dashboard (not here), then saved on that
# client's card in your dashboard for reference.
RETELL_API_KEY=
# --- Telnyx (optional -- automatically buys a real UK phone number and
# binds it to a client's Retell agent the moment "Create phone agent" is
# clicked, so no one has to wait on a number being bought and assigned by
# hand in Retell's dashboard. Without these, that step still happens, it's
# just manual -- see LAUNCH_CHECKLIST.md Step 5.) ---
# API key from https://portal.telnyx.com/#/app/api-keys after creating an
# account, adding a payment method, and completing Telnyx's identity/address
# verification (required once, for any UK numbers to become purchasable).
TELNYX_API_KEY=

# The ID of the ONE-TIME Telnyx "Connection" created in their dashboard
# (Origination pointing at sip:sip.retellai.com, Termination using a
# username/password credential) -- every future number purchase gets
# assigned to this same connection automatically. See LAUNCH_CHECKLIST.md
# Step 5 for the exact walkthrough.
TELNYX_CONNECTION_ID=

# The same connection's SIP termination URI and credentials, used to hand a
# newly-bought number straight to Retell via their phone-number import API.
TELNYX_SIP_TERMINATION_URI=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=

# Optional. Narrows automatic number searches to a specific UK city (e.g.
# "London" or "Manchester"). Leave blank to just take whatever's available
# anywhere in the UK.
TELNYX_NUMBER_LOCALITY=

# --- Google Calendar (optional -- lets a paying client's AI chat widget
# check real availability and create real appointments directly on their own
# calendar, instead of just collecting details for someone to confirm later.
# Without this, the dashboard's "Connect Google Calendar" button shows a
# setup message instead of connecting anything.) ---
# Create these at https://console.cloud.google.com -- see LAUNCH_CHECKLIST.md
# for the full step-by-step, no-code walkthrough. This is the most involved
# setup step in this checklist, worth doing together live.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Dashboard login (protects /dashboard and all /api/clients* routes) ---
# If left blank, the dashboard falls back to an insecure default password
# and logs a warning -- set a real one before sharing your live URL with anyone.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# --- Stripe (required for real payment links -- without this, the dashboard's
# "Get payment link" buttons return a demo-mode message instead) ---
# Secret key from https://dashboard.stripe.com/apikeys (starts with sk_test_
# while testing, sk_live_ once you're ready for real payments).
STRIPE_SECRET_KEY=

# Price IDs from the Products you create in the Stripe dashboard (each looks
# like price_1AbCdEfG...). One per pricing tier.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=

# Signing secret for your webhook endpoint, from the Stripe dashboard's
# Webhooks section after you add an endpoint pointing at
# https://YOUR-RENDER-URL/api/stripe/webhook (starts with whsec_).
STRIPE_WEBHOOK_SECRET=

# --- Resend (required to actually SEND an approved follow-up email to an
# unbooked lead -- without this, clicking "Send now" in the dashboard shows a
# demo-mode message instead of sending) ---
# API key from https://resend.com/api-keys after creating a free account.
RESEND_API_KEY=

# The "from" address follow-ups send from, e.g. hello@yourdomain.com. This
# address's domain must be verified inside Resend first (Resend walks you
# through adding a few DNS records) -- see LAUNCH_CHECKLIST.md.
FOLLOWUP_FROM_EMAIL=

# Optional. If set, replies from a lead land here instead of nowhere -- put
# your own inbox address so you see it and can forward it to the client.
FOLLOWUP_REPLY_TO=
