# Copy this file to .env and fill in real values before running the app.
# Never commit your real .env file to a public repository.

# Required for the AI chat demo and script generator to actually respond.
# Get this from https://console.anthropic.com (Anthropic's developer console).
ANTHROPIC_API_KEY=

# Check https://docs.claude.com/en/docs/about-claude/models for the current
# model name before deploying -- model names change over time, so confirm
# the exact string there rather than trusting this default blindly.
CLAUDE_MODEL=claude-haiku-4-5

# Port the local server runs on. Most hosting providers (Vercel, Render,
# Railway) set this automatically -- you usually don't need to touch it.
PORT=3000

# --- Optional, only needed once you're ready to connect real phone calls ---
# Get this from https://www.retellai.com after creating an account.
RETELL_API_KEY=

# The phone number you purchase inside Retell/Twilio to receive real calls.
RETELL_PHONE_NUMBER=
